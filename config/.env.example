# Copy to ./.env and fill in. Never commit the real .env.

# Telegram (required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Binance API credentials (optional; the scanner only uses public endpoints today)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Scanner settings
# Minimum net edge, in percent (0.5 = 0.5%), required to send an alert
MIN_PROFIT_THRESHOLD=0.5
# Polling interval in milliseconds (>= 1000)
CHECK_FREQUENCY_MS=30000

# Parsed from env but currently only logged (not yet used for filtering)
MARKET_FILTERS=BTC,ETH

# Logging
LOG_LEVEL=info
LOG_TO_FILE=false
